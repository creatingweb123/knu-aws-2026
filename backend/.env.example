# 로컬 개발 환경(docker compose) 예시 값. `copy .env.example .env`로 복사해 쓴다(없어도 아래 기본값으로 뜬다).
# 아래 시드 사용자는 로컬 에뮬레이터 전용 예시 값이며 실제 계정 정보가 아니다(BE-Q28).
# .env는 저장소에 올리지 않는다.

STAGE=local

# 시드 사용자 (local/init/01_haru.py가 같은 값으로 만든다)
SEED_JIYEON_EMAIL=jiyeon@example.com
SEED_JIYEON_NICKNAME=지연
SEED_SUHYUN_EMAIL=suhyun@example.com
SEED_SUHYUN_NICKNAME=수현
SEED_MINJUN_EMAIL=minjun@example.com
SEED_MINJUN_NICKNAME=민준
SEED_PASSWORD=LocalOnly-Passw0rd!

# 로컬 유저 풀. init 스크립트가 Floci 태그로 이 ID들을 고정한다.
# init 로그에 "WARNING 고정 ID가 적용되지 않았다"가 나오면 로그에 찍힌 값으로 바꾼다.
LOCAL_USER_POOL_ID=ap-northeast-2_haruLocal
LOCAL_USER_POOL_CLIENT_ID=haruLocalWebClient
# 토큰 iss(브라우저 기준 주소)와 어댑터가 JWKS를 받는 주소(컨테이너 사이 주소)
LOCAL_JWT_ISSUER=http://localhost:4566/ap-northeast-2_haruLocal
LOCAL_JWKS_URL=http://aws:4566/ap-northeast-2_haruLocal/.well-known/jwks.json

# LangSmith 추적은 항상 끈다(BE-AI-15)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# AI 하루 카드(6a). 기본은 Fake 모델이다(외부 전송 없음). 실제 키를 이 파일에 넣지 않는다.
# 실모델로 바꿀 때만 .env에서 LLM_PROVIDER=openai_compat, LLM_BASE_URL, LLM_MODEL, LLM_API_KEY를 채운다.
# BE-Q6·BE-Q7·BE-Q10 확정 전에는 실제 사용자 사연을 보내지 않는다(합성 사연만).
LLM_PROVIDER=fake
FAKE_LLM_SCENARIO=happy
LLM_API_KEY=

# 개발·검증용 실제 공급자(BE-Q6 개발용 결정, README 10.5·10.10). 합성 사연만 보낸다. 키는 .env에 직접 넣고 커밋하지 않는다.
# NVIDIA NIM은 Thinking이 기본으로 켜져 있어 반드시 끈다(켜면 content가 비어 502가 난다).
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_PROVIDER_LABEL=NVIDIA NIM
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# 6b 에이전트(design §18.4). 기본은 pipeline(레벨 0). agent로 바꾸면 체크포인트 테이블(HaruAgentCheckpoints)을 쓴다.
# 도구 호출 설정: NVIDIA NIM은 LLM_PARALLEL_TOOL_CALLS=false를 받는다(README 10.9). tool_choice는 보내지 않는다(빈 값).
AGENT_MODE=pipeline
# LLM_PARALLEL_TOOL_CALLS=false
# LLM_TOOL_CHOICE=
# 로컬 강제 종료 주입(tests/local 전용, STAGE=local에서만). 예: AGENT_CRASH_AT=model_response:1
AGENT_TEST_HOOKS=false
# AGENT_CRASH_AT=
# dev 전용 지연 주입(ai-slow, 예약 뒤 9초). 로컬은 STAGE=local일 때만 켜진다.
# FAULT_INJECT=ai-slow

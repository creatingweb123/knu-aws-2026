# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 커밋하지 않는다.
# VITE_* 값은 빌드 산출물에 그대로 들어가므로 비밀값(LLM API 키 등)을 두지 않는다(FE-TECH-03).
#
# 모드별 값 (docs/02 §2.4.7)
# | 변수                        | MSW 목업       | 로컬 백엔드                    | dev/demo 스택                  |
# | VITE_USE_MOCK               | true           | false                          | false                          |
# | VITE_API_BASE_URL           | (쓰지 않음)    | http://localhost:3000          | SAM 출력 ApiUrl                |
# | VITE_COGNITO_USER_POOL_ID   | (쓰지 않음)    | init 스크립트 출력값           | SAM 출력 UserPoolId            |
# | VITE_COGNITO_CLIENT_ID      | (쓰지 않음)    | init 스크립트 출력값           | SAM 출력 UserPoolClientId      |
# | VITE_COGNITO_ENDPOINT       | (쓰지 않음)    | http://localhost:4566          | 비움                           |
# | VITE_AUTH_MODE              | (쓰지 않음)    | cognito / dev-jwt (FE-Q8)      | cognito                        |

VITE_API_BASE_URL=
VITE_AWS_REGION=ap-northeast-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_ENDPOINT=
VITE_AUTH_MODE=cognito
VITE_USE_MOCK=true
